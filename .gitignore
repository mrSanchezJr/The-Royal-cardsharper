# ====================================================================
# The Royal Cardshaper - Git Ignore Rules
# ====================================================================

# Compiled Executables and Objects
*.o
*.obj
*.d
*.pdb
*.ilk
*.exp
*.map

# Generated asset headers (regenerated by build.bat via xxd -i)
src/king_idle_state.h
src/king_angry_state.h
src/king_overwhelmed_state.h
src/king_turned_head.h
src/btn_press.h
src/lesb_final.h
src/princess.h
src/wanderer_hooded.h
src/wanderer_idle.h
src/table_sprite.h

# UPX packer artifacts (no longer used - slim raylib build fits in 1.44MB natively)
upx.exe
*.upx

# Build tools
oxipng.exe
gen_headers.bat

# Slim raylib intermediate objects
build/

# Source art files
*.psd

# Build Artifacts
TheRoyalCardshaper.exe
bin/
obj/
out/

# Local Save Data & Logs
save.ini
*.log
*.sav

# Environment and Secrets
.env
.env.*
*.env

# Node / Web Tooling (if any scripts/tools used)
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor Configuration / Caches
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.history/

# Temporary and Cache Files
*.tmp
*.temp
*.bak
*~
.cache/

# OS Generated Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
txt.txt
